CREATE TABLE project_attachment (
    project_id TEXT NOT NULL REFERENCES studio_project(id) ON DELETE CASCADE
        CHECK (project_id <> '00000000-0000-0000-0000-000000000000'),
    snapshot_id TEXT NOT NULL REFERENCES sent_attachment(id) ON DELETE CASCADE,
    added_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, snapshot_id)
);

CREATE INDEX project_attachment_snapshot ON project_attachment(snapshot_id);

-- Use the existing visible catalogs, including saved copies without a message.
CREATE TEMPORARY TABLE project_attachment_backfill AS
SELECT owner.project_id, member.snapshot_id, min(coalesce((
    SELECT min(r.created_at) FROM chat_entry e
    JOIN message_part part ON part.revision_id = e.revision_id
    JOIN message_revision r ON r.revision_id = e.revision_id
    WHERE e.chat_id = c.id AND part.sent_attachment_id = member.snapshot_id
), 0)) AS added_at
FROM session_attachment member
JOIN chat c ON c.id = member.chat_id
JOIN studio_session owner ON owner.id = c.session_id
JOIN sent_attachment snapshot ON snapshot.id = member.snapshot_id
WHERE owner.project_id <> '00000000-0000-0000-0000-000000000000'
  AND (snapshot.uri = 'edited-image:' || snapshot.attachment_id OR EXISTS (
      SELECT 1 FROM chat_entry e JOIN message_part part ON part.revision_id = e.revision_id
      WHERE e.chat_id = c.id AND part.sent_attachment_id = member.snapshot_id
  ))
GROUP BY owner.project_id, member.snapshot_id;

INSERT INTO project_attachment(project_id, snapshot_id, added_at)
SELECT project_id, snapshot_id, added_at FROM project_attachment_backfill
ORDER BY added_at, project_id, snapshot_id;

CREATE TEMPORARY TABLE project_attachment_assert (valid INTEGER NOT NULL CHECK (valid = 1));

INSERT INTO project_attachment_assert
SELECT NOT EXISTS (
    SELECT * FROM project_attachment_backfill EXCEPT SELECT * FROM project_attachment
) AND NOT EXISTS (
    SELECT * FROM project_attachment EXCEPT SELECT * FROM project_attachment_backfill
);

DROP TABLE project_attachment_assert;
DROP TABLE project_attachment_backfill;

DELETE FROM session_attachment WHERE chat_id IN (
    SELECT c.id FROM chat c JOIN studio_session owner ON owner.id = c.session_id
    WHERE owner.project_id <> '00000000-0000-0000-0000-000000000000'
);

ALTER TABLE draft_attachment ADD COLUMN snapshot_id TEXT REFERENCES sent_attachment(id);
CREATE INDEX draft_attachment_snapshot ON draft_attachment(snapshot_id);

DROP TRIGGER register_inserted_attachment;
DROP TRIGGER register_changed_attachment;
DROP TRIGGER register_entry_attachments;
DROP TRIGGER register_new_revision_attachments;

CREATE TRIGGER register_inserted_attachment AFTER INSERT ON message_part
WHEN new.sent_attachment_id IS NOT NULL
BEGIN
    INSERT OR IGNORE INTO session_attachment(chat_id, snapshot_id)
    SELECT e.chat_id, new.sent_attachment_id FROM chat_entry e
    JOIN chat c ON c.id = e.chat_id JOIN studio_session owner ON owner.id = c.session_id
    WHERE e.revision_id = new.revision_id AND owner.project_id = '00000000-0000-0000-0000-000000000000';
    INSERT OR IGNORE INTO project_attachment(project_id, snapshot_id, added_at)
    SELECT owner.project_id, new.sent_attachment_id, r.created_at FROM chat_entry e
    JOIN chat c ON c.id = e.chat_id JOIN studio_session owner ON owner.id = c.session_id
    JOIN message_revision r ON r.revision_id = e.revision_id
    WHERE e.revision_id = new.revision_id AND owner.project_id <> '00000000-0000-0000-0000-000000000000';
END;

CREATE TRIGGER register_changed_attachment AFTER UPDATE OF sent_attachment_id ON message_part
WHEN new.sent_attachment_id IS NOT NULL AND new.sent_attachment_id IS NOT old.sent_attachment_id
BEGIN
    INSERT OR IGNORE INTO session_attachment(chat_id, snapshot_id)
    SELECT e.chat_id, new.sent_attachment_id FROM chat_entry e
    JOIN chat c ON c.id = e.chat_id JOIN studio_session owner ON owner.id = c.session_id
    WHERE e.revision_id = new.revision_id AND owner.project_id = '00000000-0000-0000-0000-000000000000';
    INSERT OR IGNORE INTO project_attachment(project_id, snapshot_id, added_at)
    SELECT owner.project_id, new.sent_attachment_id, r.created_at FROM chat_entry e
    JOIN chat c ON c.id = e.chat_id JOIN studio_session owner ON owner.id = c.session_id
    JOIN message_revision r ON r.revision_id = e.revision_id
    WHERE e.revision_id = new.revision_id AND owner.project_id <> '00000000-0000-0000-0000-000000000000';
END;

CREATE TRIGGER register_entry_attachments AFTER INSERT ON chat_entry
BEGIN
    INSERT OR IGNORE INTO session_attachment(chat_id, snapshot_id)
    SELECT new.chat_id, sent_attachment_id FROM message_part
    WHERE revision_id = new.revision_id AND sent_attachment_id IS NOT NULL
      AND EXISTS (
          SELECT 1 FROM chat c JOIN studio_session owner ON owner.id = c.session_id
          WHERE c.id = new.chat_id AND owner.project_id = '00000000-0000-0000-0000-000000000000'
      );
END;

CREATE TRIGGER register_new_revision_attachments AFTER UPDATE OF revision_id ON chat_entry
WHEN new.revision_id <> old.revision_id
BEGIN
    INSERT OR IGNORE INTO session_attachment(chat_id, snapshot_id)
    SELECT new.chat_id, p.sent_attachment_id FROM message_part p
    WHERE p.revision_id = new.revision_id AND p.sent_attachment_id IS NOT NULL
      AND EXISTS (
          SELECT 1 FROM chat c JOIN studio_session owner ON owner.id = c.session_id
          WHERE c.id = new.chat_id AND owner.project_id = '00000000-0000-0000-0000-000000000000'
      )
      AND NOT EXISTS (
          SELECT 1 FROM message_part previous
          WHERE previous.revision_id = old.revision_id AND previous.sent_attachment_id = p.sent_attachment_id
      );
    INSERT OR IGNORE INTO project_attachment(project_id, snapshot_id, added_at)
    SELECT owner.project_id, p.sent_attachment_id, r.created_at FROM message_part p
    JOIN message_revision r ON r.revision_id = p.revision_id
    JOIN chat c ON c.id = new.chat_id JOIN studio_session owner ON owner.id = c.session_id
    WHERE p.revision_id = new.revision_id AND p.sent_attachment_id IS NOT NULL
      AND owner.project_id <> '00000000-0000-0000-0000-000000000000'
      AND NOT EXISTS (
          SELECT 1 FROM message_part previous
          WHERE previous.revision_id = old.revision_id AND previous.sent_attachment_id = p.sent_attachment_id
      );
END;
