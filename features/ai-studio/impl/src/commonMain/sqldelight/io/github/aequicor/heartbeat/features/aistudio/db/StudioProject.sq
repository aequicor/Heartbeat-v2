CREATE TABLE studio_project (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    alias TEXT NOT NULL,
    working_directory TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('ACTIVE', 'ARCHIVED')),
    created_at_seconds INTEGER NOT NULL,
    created_at_nanos INTEGER NOT NULL,
    updated_at_seconds INTEGER NOT NULL,
    updated_at_nanos INTEGER NOT NULL,
    is_expanded INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX studio_project_page
ON studio_project(status, updated_at_seconds DESC, updated_at_nanos DESC, id ASC);

INSERT INTO studio_project(
    id, name, alias, working_directory, status,
    created_at_seconds, created_at_nanos, updated_at_seconds, updated_at_nanos
) VALUES ('00000000-0000-0000-0000-000000000000', ':system:ungrouped:', 'Без проекта', '', 'ACTIVE', 0, 0, 0, 0);

insertProject:
INSERT OR IGNORE INTO studio_project(
    id, name, alias, working_directory, status,
    created_at_seconds, created_at_nanos, updated_at_seconds, updated_at_nanos
)
VALUES (
    :id, :immutable_name, :immutable_name, :working_directory, 'ACTIVE',
    :now_seconds, :now_nanos, :now_seconds, :now_nanos
);

selectProjectByImmutableName:
SELECT * FROM studio_project WHERE name = :immutable_name;

selectProjectById:
SELECT * FROM studio_project WHERE id = :id;

selectActiveProjectByDirectory:
SELECT * FROM studio_project
WHERE working_directory = :working_directory AND status = 'ACTIVE'
ORDER BY created_at_seconds, created_at_nanos, id
LIMIT 1;

selectProjects:
SELECT * FROM studio_project
WHERE status = :status
  AND (
      :cursor_id IS NULL
      OR updated_at_seconds < :cursor_seconds
      OR (updated_at_seconds = :cursor_seconds AND updated_at_nanos < :cursor_nanos)
      OR (updated_at_seconds = :cursor_seconds AND updated_at_nanos = :cursor_nanos AND id > :cursor_id)
  )
ORDER BY updated_at_seconds DESC, updated_at_nanos DESC, id ASC
LIMIT :fetch_limit;

updateProjectExpanded:
UPDATE studio_project SET is_expanded = :is_expanded WHERE id = :id;

updateProjectTitle:
UPDATE studio_project
SET alias = :title, updated_at_seconds = :now_seconds, updated_at_nanos = :now_nanos
WHERE id = :id AND alias != :title;

updateProjectStatus:
UPDATE studio_project
SET status = :status, updated_at_seconds = :now_seconds, updated_at_nanos = :now_nanos
WHERE id = :id AND status != :status;

deleteProjectSessions:
DELETE FROM studio_session WHERE project_id = :id;

deleteProject:
DELETE FROM studio_project WHERE id = :id;
