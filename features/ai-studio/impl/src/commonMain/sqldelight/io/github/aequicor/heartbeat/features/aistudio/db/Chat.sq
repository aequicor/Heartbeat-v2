CREATE TABLE chat (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    snapshot TEXT
);

CREATE TABLE chat_workspace (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    snapshot TEXT NOT NULL
);

selectById:
SELECT id, title
FROM chat
WHERE id = ?;

selectAll:
SELECT id, title
FROM chat
ORDER BY title ASC;

insert:
INSERT OR REPLACE INTO chat(id, title)
VALUES (?, ?);

deleteById:
DELETE FROM chat
WHERE id = ?;

selectSnapshots:
SELECT id, snapshot
FROM chat
WHERE snapshot IS NOT NULL;

upsertSnapshot:
INSERT OR REPLACE INTO chat(id, title, snapshot)
VALUES (?, ?, ?);

selectWorkspace:
SELECT snapshot
FROM chat_workspace
WHERE id = 1;

upsertWorkspace:
INSERT OR REPLACE INTO chat_workspace(id, snapshot)
VALUES (1, ?);
